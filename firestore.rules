rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidBannerConfig(data) {
      return data.keys().hasAll([
        'isActive',
        'text',
        'ctaLabel',
        'ctaTarget',
        'theme',
        'dismissible',
        'updatedAt',
        'updatedBy'
      ]) &&
      data.keys().hasOnly([
        'isActive',
        'text',
        'ctaLabel',
        'ctaTarget',
        'theme',
        'dismissible',
        'updatedAt',
        'updatedBy'
      ]) &&
      data.isActive is bool &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 140 &&
      data.ctaLabel is string && data.ctaLabel.size() <= 40 &&
      data.ctaTarget in ['none', 'customize', 'shipping', 'contact', 'whatsapp'] &&
      data.theme in ['navy', 'slate', 'emerald', 'amber'] &&
      data.dismissible is bool &&
      data.updatedAt == request.time &&
      data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['role', 'createdAt']) &&
      data.keys().hasOnly(['role', 'createdAt']) &&
      data.role == 'admin' &&
      data.createdAt == request.time;
    }

    // Storefront public configuration (only single 'banner' doc readable publicly)
    match /site_settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'banner';
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(settingId) &&
        settingId == 'banner' &&
        isValidBannerConfig(incoming());

      allow update: if isAdmin() &&
        isValidId(settingId) &&
        settingId == 'banner' &&
        isValidBannerConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isActive',
          'text',
          'ctaLabel',
          'ctaTarget',
          'theme',
          'dismissible',
          'updatedAt',
          'updatedBy'
        ]);

      allow delete: if false;
    }

    // Admin registry (PII-free, only role + createdAt)
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isAdmin() && isValidId(userId) && isValidAdminUser(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
